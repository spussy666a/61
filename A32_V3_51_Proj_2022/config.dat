-z0 0             ; Default Daylight time setting   [0 standard, 1 daylight]
-z -8:00:00          ; Default time zone               [hours before GMT      ]
-zl 116:28E 39:55N  ; Default longitude and latitude
-zn "London, UK"  ; Default location name
